# KARMA — example environment (copy to .env; .env is gitignored)
# Live-verified values recorded 2026-06-15 (scripts/check_connectivity.ts).

# ── KARMA Core ───────────────────────────────────────────────
NODE_ENV=development
TRANSPORT_DRIVER=http
HTTP_HOST=127.0.0.1
HTTP_PORT=3333
STORAGE_DRIVER=fs
MCP_PROJECT_ID=KARMA
MCP_TENANT_ID=tenant_local
TELEMETRY_DRIVER=stderr
MCP_AUTH_MODE=api_key
MCP_API_KEY=replace-with-at-least-32-char-random-string
ALLOWED_HOSTS=127.0.0.1:3333,localhost:3333
ALLOWED_ORIGINS=http://localhost:3333

# ── Plugin System — in-process trusted built-in (D-1/D-3) ────
# karma.tool.ts, t3.tool.ts, and casper.tool.ts run in-process (isTrustedBuiltInPlugin); external
# isolation is UNSUPPORTED for KARMA (per-call fork drops singletons + workerEnv() strips
# PHAROS_*/KEYSTORE_*/CASPER_*).
MCP_SAFE_MODE=false
MCP_PLUGIN_ISOLATION_MODE=policy
MCP_PLUGIN_ALLOWLIST=system.tool.ts,karma.tool.ts,t3.tool.ts,casper.tool.ts

# ── Terminal3 (T3ADK) ─────────────────────────────────────────
# Leave T3N_NODE_URL blank to use the SDK's built-in testnet URL.
# T3N_NODE_URL=

# ── Abuse Controls ───────────────────────────────────────────
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_MS=60000

# ── Pharos Atlantic (LIVE-VERIFIED 2026-06-15) ───────────────
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com
PHAROS_WSS_URL=wss://atlantic.dplabs-internal.com
PHAROS_CHAIN_ID=688689
PHAROS_CONTRACT_ADDRESS=0xReplaceAfterDeploy
PHAROS_EXPLORER=https://atlantic.pharosscan.xyz/
# Block to start the skill-event indexer backfill from (default 0 = full history).
KARMA_INDEXER_FROM_BLOCK=0

# ── Keystore (in-process only; never passed to a child worker) ──
KEYSTORE_PATH=./keystore.json
KEYSTORE_PASSWORD=replace-with-strong-password

# ── Casper Testnet (T9-T13 — Odra AgentSkillRegistry + x402 fast lane) ───────
# Leave all unset to run every Casper demo script offline (InProcessRegistry / dry-run).
# `rpc.testnet.casper.network` (this var's old value) does not resolve in DNS — it never
# existed as a public no-key endpoint. cspr.cloud is the real, working RPC, but as of 2026-07
# it requires a free API key (sign up at cspr.cloud) — set it via CASPER_RPC_API_KEY below,
# sent as a raw `Authorization: <key>` header (no "Bearer " prefix; cspr.cloud rejects that).
# CASPER_RPC_URL=https://node.testnet.cspr.cloud/rpc
# CASPER_RPC_API_KEY=
# Contract package hash printed by the install deploy (see DEMO_CASPER.md §Live run, Step 1;
# `contracts-odra/build-wasm.sh` needs target-cpu=mvp + -Z build-std — plain
# target-feature=-bulk-memory is not enough, recent rustc/LLVM still emits memory.copy/fill
# even with that flag alone). Real install cost on testnet was ~579 CSPR, not the 200 CSPR
# this doc used to say — pass a payment close to (but under) the network's block_gas_limit
# (812.5 CSPR on this testnet as of 2026-07; check chainspec, don't assume it's still that).
# Below is the current canonical deployment (Locked, N-of-M panel active, 2026-07-25 redeploy —
# see DEMO_CASPER.md's redeploy chain) — public info, safe to commit, override only if you
# deploy your own instance.
CASPER_CONTRACT_HASH=hash-2262a0a9e683640a350c2c444501bbde04797458d8abcdada9fbfa49bdbb7384
# Same value as CASPER_CONTRACT_HASH — src/lib/casper/odra_registry.ts and
# register_rwa_oracle_skill.ts / demo_casper_x402_live.ts read this name.
KARMA_ODRA_REGISTRY=hash-2262a0a9e683640a350c2c444501bbde04797458d8abcdada9fbfa49bdbb7384
CASPER_CHAIN_NAME=casper-test
# X402SettlementToken, same redeploy chain (Locked, canonical) — see README's Live deployment table.
KARMA_X402_CASPER_SETTLEMENT_TOKEN=hash-6667f2d01cbf2af3b8ddca847c4e4294ea623f8bdc3dfe588af47ba56fc4cf3a
# Casper's x402 fast-lane facilitator (announced with the Casper AI Toolkit). No
# `@x402/casper` package exists yet, so x402_casper.ts builds the signed payload directly;
# this URL is only used as the receipt's `facilitatorRef` until that lands.
# CASPER_X402_FACILITATOR_URL=https://x402-facilitator.casper.network
